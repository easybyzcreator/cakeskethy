rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que todos vejam o cardápio
    match /{document=**} {
      allow read: if true;
    }

    // LIBERAÇÃO TOTAL PARA O PAINEL ADM (Categorias, Produtos, Galerias e Configurações)
    // Usamos {document=**} para garantir que subpastas (como as fotos das galerias) também funcionem
    match /appData/{document=**} { allow write: if true; }
    match /products/{document=**} { allow write: if true; }
    match /categories/{document=**} { allow write: if true; }
    match /galleryCategories/{document=**} { allow write: if true; }
    match /galleryImages/{document=**} { allow write: if true; }
    match /styles/{document=**} { allow write: if true; }
    match /orders/{document=**} { allow write: if true; }
    match /customers/{document=**} { allow write: if true; }
  }
}
